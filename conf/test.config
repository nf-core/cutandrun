/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/cutandrun -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
    withName:BWAMEM2_INDEX {
        memory = { 6.GB }
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input = params.pipelines_testdata_base_path + 'cutandrun/samplesheet_2_0/test-GSE145187-small.csv'

    // Genome references
    fasta                      = params.pipelines_testdata_base_path + 'cutandrun/reference/genomes/hg38-chr20.fa.gz'
    bowtie2                    = params.pipelines_testdata_base_path + 'cutandrun/reference/genomes/hg38-chr20-bowtie2.tar.gz'
    gtf                        = params.pipelines_testdata_base_path + 'cutandrun/reference/genomes/hg38-chr20-genes.gtf.gz'
    gene_bed                   = params.pipelines_testdata_base_path + 'cutandrun/reference/genomes/hg38-chr20-genes.bed.gz'
    blacklist                  = "${projectDir}/assets/blacklists/hg38-blacklist.bed"
    spikein_fasta              = params.pipelines_testdata_base_path + 'cutandrun/reference/genomes/e_coli_U00096_3.fa.gz'
    spikein_bowtie2            = params.pipelines_testdata_base_path + 'cutandrun/reference/genomes/e_coli_U00096_3.tar.gz'
    mito_name                  = 'chrM'
    remove_linear_duplicates   = true
    remove_mitochondrial_reads = true
}
