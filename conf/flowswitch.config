/*
 * ---------------------------------------------------
 *  Nextflow config file for deciding which parts of
 *  the pipeline will run
 * ---------------------------------------------------
 *
 *  Each block below is a separate `params { }` scope so the strict config
 *  parser (Nextflow >= 26.04) accepts the conditional overrides without
 *  resorting to top-level `if` statements. The blocks are evaluated in the
 *  order given; later blocks can reference values written by earlier ones.
 */

// Defaults
params {
    run_genome_prep        = true
    run_cat_fastq          = true
    run_trim_galore_fastqc = true

    run_alignment          = true
    run_read_filter        = true
    run_preseq             = true
    run_mark_dups          = true
    run_remove_dups        = true
    run_remove_linear_dups = false

    run_peak_calling       = true
    run_consensus_all      = false

    run_reporting          = true
    run_deeptools_heatmaps = true
    run_deeptools_qc       = true
    run_peak_qc            = true
    run_multiqc            = true
    run_igv                = true
}

// Mode-driven overrides
params {
    run_consensus_all      = params.consensus_peak_mode == 'all' ? true  : params.run_consensus_all
    run_remove_linear_dups = params.remove_linear_duplicates    ? true  : params.run_remove_linear_dups
}

// skip_* overrides
params {
    run_remove_dups        = (params.skip_removeduplicates || !params.run_mark_dups) ? false : params.run_remove_dups
    run_remove_linear_dups = params.skip_removeduplicates ? false : params.run_remove_linear_dups
    run_preseq             = params.skip_preseq           ? false : params.run_preseq
    run_deeptools_heatmaps = params.skip_heatmaps         ? false : params.run_deeptools_heatmaps
    run_deeptools_qc       = params.skip_dt_qc            ? false : params.run_deeptools_qc
    run_peak_qc            = params.skip_peak_qc          ? false : params.run_peak_qc
    run_igv                = params.skip_igv              ? false : params.run_igv
    run_reporting          = params.skip_reporting        ? false : params.run_reporting
    run_preseq             = params.skip_reporting        ? false : params.run_preseq
    run_multiqc            = params.skip_reporting        ? false : params.run_multiqc
}

// only_input
params {
    run_genome_prep        = params.only_input ? false : params.run_genome_prep
    run_cat_fastq          = params.only_input ? false : params.run_cat_fastq
    run_trim_galore_fastqc = params.only_input ? false : params.run_trim_galore_fastqc
    run_alignment          = params.only_input ? false : params.run_alignment
    run_read_filter        = params.only_input ? false : params.run_read_filter
    run_preseq             = params.only_input ? false : params.run_preseq
    run_mark_dups          = params.only_input ? false : params.run_mark_dups
    run_remove_dups        = params.only_input ? false : params.run_remove_dups
    run_remove_linear_dups = params.only_input ? false : params.run_remove_linear_dups
    run_peak_calling       = params.only_input ? false : params.run_peak_calling
    run_reporting          = params.only_input ? false : params.run_reporting
    run_multiqc            = params.only_input ? false : params.run_multiqc
}

// only_genome
params {
    run_cat_fastq          = params.only_genome ? false : params.run_cat_fastq
    run_trim_galore_fastqc = params.only_genome ? false : params.run_trim_galore_fastqc
    run_alignment          = params.only_genome ? false : params.run_alignment
    run_read_filter        = params.only_genome ? false : params.run_read_filter
    run_preseq             = params.only_genome ? false : params.run_preseq
    run_mark_dups          = params.only_genome ? false : params.run_mark_dups
    run_remove_dups        = params.only_genome ? false : params.run_remove_dups
    run_remove_linear_dups = params.only_genome ? false : params.run_remove_linear_dups
    run_peak_calling       = params.only_genome ? false : params.run_peak_calling
    run_reporting          = params.only_genome ? false : params.run_reporting
    run_multiqc            = params.only_genome ? false : params.run_multiqc
}

// only_preqc
params {
    run_genome_prep        = params.only_preqc ? false : params.run_genome_prep
    run_alignment          = params.only_preqc ? false : params.run_alignment
    run_read_filter        = params.only_preqc ? false : params.run_read_filter
    run_preseq             = params.only_preqc ? false : params.run_preseq
    run_mark_dups          = params.only_preqc ? false : params.run_mark_dups
    run_remove_dups        = params.only_preqc ? false : params.run_remove_dups
    run_remove_linear_dups = params.only_preqc ? false : params.run_remove_linear_dups
    run_peak_calling       = params.only_preqc ? false : params.run_peak_calling
    run_reporting          = params.only_preqc ? false : params.run_reporting
    run_multiqc            = params.only_preqc ? true  : params.run_multiqc
}

// only_alignment
params {
    run_read_filter        = params.only_alignment ? false : params.run_read_filter
    run_preseq             = params.only_alignment ? false : params.run_preseq
    run_mark_dups          = params.only_alignment ? false : params.run_mark_dups
    run_remove_dups        = params.only_alignment ? false : params.run_remove_dups
    run_remove_linear_dups = params.only_alignment ? false : params.run_remove_linear_dups
    run_peak_calling       = params.only_alignment ? false : params.run_peak_calling
    run_reporting          = params.only_alignment ? false : params.run_reporting
    run_multiqc            = params.only_alignment ? true  : params.run_multiqc
}

// only_filtering
params {
    run_peak_calling       = params.only_filtering ? false : params.run_peak_calling
    run_reporting          = params.only_filtering ? false : params.run_reporting
    run_multiqc            = params.only_filtering ? true  : params.run_multiqc
}

// only_peak_calling
params {
    run_reporting          = params.only_peak_calling ? false : params.run_reporting
    run_multiqc            = params.only_peak_calling ? true  : params.run_multiqc
}

// skip_multiqc applied last so it overrides any only_* enabling
params {
    run_multiqc            = params.skip_multiqc ? false : params.run_multiqc
}
