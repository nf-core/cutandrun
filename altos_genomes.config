            star             = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Index/STARIndex/"
        }

        'Lambda'{
            // Escherichia virus Lambda, Lambda phage, GenBank, J02459.1 in GenBank
            fasta      = "s3://altos-lab-reference-data/genomes/Lambda/Ensembl/Lambda/Sequence/WholeGenomeFasta/Lambda.fa"
            bowtie2    = "s3://altos-lab-reference-data/genomes/Lambda/Ensembl/Lambda/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/Lambda/Ensembl/Lambda/Index/Hisat2Index/"
            bismark    = "s3://altos-lab-reference-data/genomes/Lambda/Ensembl/Lambda/Index/BismarkIndex/"
            readme     = "s3://altos-lab-reference-data/genomes/Lambda/Ensembl/Lambda/Annotation/README.txt"
        }

        'Macaca_fascicularis_6.0' {
            // Macaca fascicularis, Crab-eating macaque, Mauritian strain, cy0333 isolate, Ensembl, GCA_011100615.1
            fasta            = "s3://altos-lab-reference-data/genomes/Macaca_fascicularis/Ensembl/Macaca_fascicularis_6.0/Sequence/WholeGenomeFasta/Macaca_fascicularis.Macaca_fascicularis_6.0.fa"
            bismark          = "s3://altos-lab-reference-data/genomes/Macaca_fascicularis/Ensembl/Macaca_fascicularis_6.0/Index/BismarkIndex/"
            bowtie2          = "s3://altos-lab-reference-data/genomes/Macaca_fascicularis/Ensembl/Macaca_fascicularis_6.0/Index/Bowtie2Index/"
            bwa              = "s3://altos-lab-reference-data/genomes/Macaca_fascicularis/Ensembl/Macaca_fascicularis_6.0/Index/BWAIndex/"
