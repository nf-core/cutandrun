/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for custom Genomes path within Altos
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines reference genomes using Genome paths.
    Can be used by any config that customises the base path using:
    // includeConfig ('s3://altos-lab-reference-data/altos_genomes.config')
----------------------------------------------------------------------------------------
*/

params {
    // Genome reference file paths
    genomes {
        // Please add new config stanzas in alphabetical order of Genome ID to make it simpler to search

        ////////////////////////////////////////////////
        /////////////// STANDARD GENOMES ///////////////
        ////////////////////////////////////////////////

        // These are the standard genomes that were generated using publicly available assembly and annotation files
        // Some of these are the ones that get routinely used by the pipelines at Altos Labs
        // If you're adding a custom genome, make sure you add in the CUSTOM GENOMES section below

        'AmbMex60DD' {
            // Ambystoma mexicanum, Axolotl, DD151 strain, Axolotl-omics, GCA_002915635.3
            fasta            = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Sequence/WholeGenomeFasta/Ambystoma_mexicanum.AmbMex60DD.fa"
            bismark          = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/BismarkIndex/"
            bowtie2          = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/Bowtie2Index/"
            bwa              = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/BWAIndex/"
            gtf              = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Annotation/Genes/Ambystoma_mexicanum.Axolotlomics.v47.gtf"
            cellranger       = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/CellRangerIndex/"
            cellrangerarc    = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/CellRangerArcIndex/"
            hisat2           = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/Hisat2Index/"
            rsem             = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/STARIndex/"
            transcript_fasta = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/STARIndex/genome.transcripts.fa"
            salmon           = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/salmon/"
            star             = "s3://altos-lab-reference-data/genomes/Ambystoma_mexicanum/Axolotlomics/AmbMex60DD/Index/STARIndex/"
        }

        'Amel_HAv3.1' {
            // Apis mellifera, European honey bee, DH4 strain, Ensembl Metazoa, GCA_003254395.2
            fasta            = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Sequence/WholeGenomeFasta/Apis_mellifera.Amel_HAv3.1.fa"
            bismark          = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/BismarkIndex/"
            bowtie2          = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/Bowtie2Index/"
            bwa              = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/BWAIndex/"
            gtf              = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Annotation/Genes/Apis_mellifera.Ensembl.Amel_HAv3.1.gtf"
            cellranger       = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/CellRangerIndex/"
            cellrangerarc    = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/CellRangerArcIndex/"
            hisat2           = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/Hisat2Index/"
            rsem             = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/STARIndex/"
            transcript_fasta = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/STARIndex/genome.transcripts.fa"
            salmon           = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/salmon/"
            star             = "s3://altos-lab-reference-data/genomes/Apis_mellifera/Ensembl/Amel_HAv3.1/Index/STARIndex/"
        }

        'BDGP6.32' {
            // Drosophila melanogaster, Fruit fly, iso-1 strain, Ensembl, GCA_000001215.4
            fasta      = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Sequence/WholeGenomeFasta/Drosophila_melanogaster.BDGP6.32.dna.toplevel.fa"
            bwa        = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/BWAIndex/"
            bowtie2    = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/Hisat2Index/"
            star       = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/STARIndex/"
            rsem       = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/STARIndex/"
            transcript_fasta = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/STARIndex/genome.transcripts.fa"
            salmon     = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/salmon/"
            bismark    = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Index/BismarkIndex/"
            gtf        = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Annotation/Genes/Drosophila_melanogaster.BDGP6.32.109.gtf"
            bed12      = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Annotation/Genes/Drosophila_melanogaster.BDGP6.32.109.bed"
            readme     = "s3://altos-lab-reference-data/genomes/Drosophila_melanogaster/Ensembl/BDGP6.32/Annotation/README.txt"
        }

        'E_coli_K12' {
            // Escherichia coli, K12 strain, MG1655 substrain, NCBI, GCA_000005845.2
            fasta      = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Sequence/WholeGenomeFasta/E_coli_K12.fa"
            // bwa        = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Index/BWAIndex/"
            bowtie2    = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Index/Hisat2Index/"
            // star       = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Index/STARIndex/"
            bismark    = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Index/BismarkIndex/"
            gtf        = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Annotation/Genes/GCF_000005845.2_ASM584v2_genomic.gtf"
            // bed12      = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Annotation/Genes/"
            readme     = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Annotation/README.txt"
        }

        'ERCC' {
            // External RNA Controls Consortium, ERCC spike-in, ERCC92, ThermoFisher, https://assets.thermofisher.com/TFS-Assets/LSG/manuals/ERCC92.zip
            fasta      = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Sequence/WholeGenomeFasta/ERCC92.fa"
            bwa        = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Index/BWAIndex/"
            bowtie2    = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Index/Hisat2Index/"
            star       = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Index/STARIndex/"
            rsem       = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Index/STARIndex/"
            bismark    = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Index/BismarkIndex/"
            gtf        = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Annotation/Genes/ERCC92.gtf"
            bed12      = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Annotation/Genes/ERCC92.bed"
            readme     = "s3://altos-lab-reference-data/genomes/Spike_in/ERCC92/Annotation/README.txt"
        }

        'GRCh37' {
            // WARNING: This genome assembly is OUTDATED. It should not be use unless there is a very good reason to do so. Use GRCh38 instead.
            // Homo sapiens, Human, Ensembl, GCA_000001405.1
            fasta      = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Sequence/WholeGenomeFasta/Homo_sapiens.GRCh37.dna.primary_assembly.fa"
            bwa        = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/BWAIndex/"
            bowtie2    = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/Hisat2Index/"
            star       = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/STARIndex/"
            rsem       = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/STARIndex/"
            transcript_fasta = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/STARIndex/genome.transcripts.fa"
            salmon     = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/salmon/"
            bismark    = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Index/BismarkIndex/"
            gtf        = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/Genes/Homo_sapiens.GRCh37.87.gtf"
            bed12      = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/Genes/Homo_sapiens.GRCh37.87.bed"
            readme     = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh37/Annotation/README.txt"
            spikein    = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Sequence/WholeGenomeFasta/E_coli_K12.fa"
            mito_name  = "MT"
        }

        'GRCh38' {
            // Homo sapiens, Human, Ensembl, GCA_000001405.29
            fasta      = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens.GRCh38.dna.primary_assembly.fa"
            bwa        = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/BWAIndex/"
            bwa_L1EM   = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/bwa_L1EM/"
            bowtie2    = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/Hisat2Index/"
            star       = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/STARIndex/"
            rsem       = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/STARIndex/"
            simpleaf    = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/SimpleafIndex"
            simpleaf_atac = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/SimpleafATACIndex/"
            cellranger = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/CellrangerIndex/"
            cellrangerarc = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/CellrangerArc/"
            transcript_fasta = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/STARIndex/genome.transcripts.fa"
            salmon     = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/salmon/"
            bismark    = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/BismarkIndex/"
            gtf        = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/Genes/Homo_sapiens.GRCh38.108.gtf"
            bed12      = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/Genes/Homo_sapiens.GRCh38.108.bed"
            readme     = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/README.txt"
            spikein    = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Sequence/WholeGenomeFasta/E_coli_K12.fa"
            simpleaf_tx2pgene = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Index/SimpleafIndex/t2g_3col.tsv"
            blacklist  = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/Blacklists/GRCh38_blacklist.bed"
            ascat_alleles           = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/ASCAT/G1000_alleles_GRCh38.zip"
            ascat_genome            = 'hg38'
            ascat_loci              = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/ASCAT/G1000_loci_GRCh38.zip"
            ascat_loci_gc           = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/ASCAT/GC_G1000_GRCh38.zip" 
            ascat_loci_rt           = "s3://altos-lab-reference-data/genomes/Homo_sapiens/Ensembl/GRCh38/Annotation/ASCAT/RT_G1000_GRCh38.zip"
            mito_name  = "MT"
        }

        'GRCm38' {
            // WARNING: This genome assembly is OUTDATED. It should not be use unless there is a very good reason to do so. Use GRCm39 instead.
            // Mus musculus, House mouse, C57BL/6J strain, Ensembl, GCA_000001635.2
            fasta      = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Sequence/WholeGenomeFasta/Mus_musculus.GRCm38.dna.primary_assembly.fa"
            bwa        = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/BWAIndex/"
            bowtie2    = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/Hisat2Index/"
            star       = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/STARIndex/"
            rsem       = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/STARIndex/"
            transcript_fasta = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/STARIndex/genome.transcripts.fa"
            salmon     = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/salmon/"
            bismark    = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/BismarkIndex/"
            gtf        = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Annotation/Genes/Mus_musculus.GRCm38.102.gtf"
            bed12      = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Annotation/Genes/Mus_musculus.GRCm38.102.bed"
            readme     = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Annotation/README.txt"
            cellranger = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/CellrangerIndex/"
            cellrangerarc = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm38/Index/CellrangerArc/"
            spikein    = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Sequence/WholeGenomeFasta/E_coli_K12.fa"
            mito_name  = "MT"
        }

        'GRCm39' {
            // Mus musculus, House mouse, C57BL/6J strain, Ensembl, GCA_000001635.9
            fasta      = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Sequence/WholeGenomeFasta/Mus_musculus.GRCm39.dna.primary_assembly.fa"
            bwa        = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/BWAIndex/"
            bwa_L1EM   = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/bwa_L1EM/"
            bowtie2    = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/Bowtie2Index/"
            hisat2     = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/Hisat2Index/"
            star       = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/STARIndex/"
            rsem       = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/STARIndex/"
            simpleaf    = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/SimpleafIndex"
            simpleaf_atac = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/SimpleafATACIndex/"
            cellranger = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/CellrangerIndex/"
            cellrangerarc = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/CellrangerArc/"
            salmon     = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/salmon/"
            transcript_fasta = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/STARIndex/genome.transcripts.fa"
            bismark    = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/BismarkIndex/"
            gtf        = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Annotation/Genes/Mus_musculus.GRCm39.108.gtf"
            bed12      = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Annotation/Genes/Mus_musculus.GRCm39.108.bed"
            readme     = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Annotation/README.txt"
            simpleaf_tx2pgene = "s3://altos-lab-reference-data/genomes/Mus_musculus/Ensembl/GRCm39/Index/SimpleafIndex/t2g_3col.tsv"
            spikein    = "s3://altos-lab-reference-data/genomes/E_coli/NCBI/E_coli_K12/Sequence/WholeGenomeFasta/E_coli_K12.fa"
            mito_name  = "MT"
        }

        'GRCz11' {
            // Danio rerio, Zebrafish, Tuebingen strain, Ensembl, GCA_000002035.4
            fasta            = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Sequence/WholeGenomeFasta/Danio_rerio.GRCz11.fa"
            bismark          = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Index/BismarkIndex/"
            bowtie2          = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Index/Bowtie2Index/"
            bwa              = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Index/BWAIndex/"
            gtf              = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Annotation/Genes/Danio_rerio.Ensembl.GRCz11.gtf"
