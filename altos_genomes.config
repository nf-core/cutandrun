            hisat2           = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Index/Hisat2Index/"
            rsem             = "s3://altos-lab-reference-data/genomes/Danio_rerio/Ensembl/GRCz11/Index/STARIndex/"
